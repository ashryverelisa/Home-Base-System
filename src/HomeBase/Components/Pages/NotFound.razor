@page "/not-found"
@layout MainLayout
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@Localizer["NotFound.Title"]</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-2">@Localizer["NotFound.Title"]</MudText>
<MudText Typo="Typo.body1" Class="mb-4">@Localizer["NotFound.Message"]</MudText>

<MudButton Href="/"
           Variant="Variant.Filled"
           Color="Color.Primary"
           StartIcon="@Icons.Material.Filled.Home">
    @Localizer["Nav.Overview"]
</MudButton>
