        @Localizer["Nav.Overview"]
    </MudNavLink>
    <MudNavLink Href="inventory" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Inventory2">
        @Localizer["Nav.Stock"]
    </MudNavLink>
    <MudNavLink Href="products" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ListAlt">
        @Localizer["Nav.Products"]
    </MudNavLink>
</MudNavMenu>