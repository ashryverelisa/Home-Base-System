@inherits LayoutComponentBase
@inject IStringLocalizer<AppStrings> Localizer

<MudThemeProvider @ref="_themeProvider"
                  Theme="AppTheme.Instance"
                  @bind-IsDarkMode="_isDarkMode"
                  ObserveSystemDarkModeChange="false"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       title="@Localizer["Nav.Menu"]"
                       OnClick="@ToggleDrawer"/>
        <MudText Typo="Typo.h6" Class="ml-2">HomeBase</MudText>

        <MudSpacer/>

        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit"
                       title="@(_isDarkMode ? Localizer["Layout.LightMode"] : Localizer["Layout.DarkMode"])"
                       OnClick="@ToggleTheme"/>
        <CultureSelector/>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               ClipMode="DrawerClipMode.Always"
               Variant="DrawerVariant.Responsive"
               Elevation="1">
        <NavMenu/>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
            <CascadingValue Value="_isDarkMode" Name="IsDarkMode">
                @Body
            </CascadingValue>
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    @Localizer["Layout.UnhandledError"]
    <a href="." class="reload">@Localizer["Layout.Reload"]</a>
    <span class="dismiss">🗙</span>
</div>