@page "/inventory"
@inject IInventoryService Inventory
@inject ICatalogService Catalog
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@Localizer["Stock.Title"]</PageTitle>

<div class="d-flex justify-space-between align-center flex-wrap gap-3 mb-4">
    <MudText Typo="Typo.h4" HtmlTag="h1">@Localizer["Stock.Title"]</MudText>
    <MudButton Href="/inventory/book-in"
               Variant="Variant.Filled"
               Color="Color.Primary"
               Size="Size.Large"
               StartIcon="@Icons.Material.Filled.AddShoppingCart">
        @Localizer["BookIn.Title"]
    </MudButton>
</div>

<MudChipSet T="int?"
            SelectionMode="SelectionMode.SingleSelection"
            SelectedValue="_withinDays"
            SelectedValueChanged="SetFilterAsync"
            CheckMark="true"
            Class="mb-4">
    <MudChip T="int?" Value="@(null)" Color="Color.Primary" Variant="Variant.Outlined">
        @Localizer["Stock.FilterAll"]
    </MudChip>
    <MudChip T="int?" Value="@(3)" Color="Color.Primary" Variant="Variant.Outlined">
        @Localizer["Stock.FilterExpiring", 3]
    </MudChip>
    <MudChip T="int?" Value="@(14)" Color="Color.Primary" Variant="Variant.Outlined">
        @Localizer["Stock.FilterExpiring", 14]
    </MudChip>
</MudChipSet>

@if (_lots is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary"/>
}
else if (_lots.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        @(_withinDays is null ? Localizer["Stock.Empty"] : Localizer["Stock.EmptyForFilter"])
    </MudAlert>
}
else
{
    @foreach (var group in _lots.GroupBy(l => l.LocationName ?? Localizer["Stock.NoLocation"].Value))
    {
        <MudText Typo="Typo.h6" Class="mt-6 mb-2 d-flex align-center gap-2">
            <MudIcon Icon="@Zones.Icon(group.First().LocationZone)" Size="Size.Medium"/>
            @group.Key
        </MudText>

        <MudPaper Outlined="true">
            @foreach (var lot in group)
            {
                <div class="pa-4">
                    <div class="d-flex justify-space-between align-start flex-wrap gap-2">
                        <div>
                            <MudText Typo="Typo.body1">
                                <b>@lot.ProductName</b>
                                @if (lot.IsOpened)
                                {
                                    <MudChip T="string" Size="Size.Small" Class="ml-2">
                                        @Localizer["Stock.OpenedBadge"]
                                    </MudChip>
                                }
                            </MudText>
                            <MudText Typo="Typo.caption" Color="@BestBeforeColor(lot)">
                                @if (!string.IsNullOrWhiteSpace(lot.Brand))
                                {
                                    <span>@lot.Brand · </span>
                                }
                                <span>@BestBeforeText(lot)</span>
                                @if (lot.Value is { } value)
                                {
                                    <span> · @Units.Money(value)</span>
                                }
                            </MudText>
                        </div>
                        <MudText Typo="Typo.h6">@Units.Format(lot.QuantityBase, lot.BaseUnit)</MudText>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   OnClick="() => Begin(lot, StockMovementType.Consume)">
                            @Localizer["Stock.Consume"]
                        </MudButton>
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   OnClick="() => Begin(lot, StockMovementType.Waste)">
                            @Localizer["Stock.Waste"]
                        </MudButton>
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.MoveDown"
                                   OnClick="() => BeginMove(lot)">
                            @Localizer["Stock.Move"]
                        </MudButton>
                        @if (!lot.IsOpened)
                        {
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       OnClick="() => OpenAsync(lot)">
                                @Localizer["Stock.MarkOpened"]
                            </MudButton>
                        }
                    </div>

                    @if (_active?.LotId == lot.LotId)
                    {
                        <MudDivider Class="my-3"/>

                        <div class="d-flex flex-wrap align-center gap-2">
                            <MudNumericField @bind-Value="_amount"
                                             Label="@Localizer["Stock.AmountLabel", Units.Abbreviation(lot.BaseUnit), MovementLabel]"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Min="0"
                                             Style="max-width: 14rem"/>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Disabled="_busy.IsBusy"
                                       OnClick="@ApplyAsync">
                                @Localizer["Stock.Book"]
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       Disabled="_busy.IsBusy"
                                       OnClick="@ApplyAllAsync">
                                @Localizer["Stock.BookAll", Units.Format(lot.QuantityBase, lot.BaseUnit)]
                            </MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="@Cancel">
                                @Localizer["Common.Cancel"]
                            </MudButton>
                        </div>

                        @if (_message is not null)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-3">
                                @_message
                            </MudAlert>
                        }
                    }

                    @if (_moving?.LotId == lot.LotId)
                    {
                        <MudDivider Class="my-3"/>

                        <div class="d-flex flex-wrap align-center gap-2">
                            <MudSelect T="int?"
                                       @bind-Value="_moveLocationId"
                                       Label="@Localizer["Stock.MoveTo"]"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Style="min-width: 14rem">
                                <MudSelectItem T="int?" Value="@(null)">@Localizer["Stock.NoLocation"]</MudSelectItem>
                                @foreach (var location in _locations)
                                {
                                    <MudSelectItem T="int?" Value="@(location.Id)">@LocationTree.Label(location)</MudSelectItem>
                                }
                            </MudSelect>
                            @if (MoveChangesShelfLife)
                            {
                                <MudDatePicker @bind-Date="MoveBestBeforeDate"
                                               Label="@Localizer["Stock.NewBestBefore"]"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               Editable="true"
                                               Clearable="true"
                                               Style="max-width: 14rem"/>
                            }
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Disabled="_busy.IsBusy"
                                       OnClick="@MoveAsync">
                                @Localizer["Stock.Move"]
                            </MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="@CancelMove">
                                @Localizer["Common.Cancel"]
                            </MudButton>
                        </div>

                        @if (MoveChangesShelfLife)
                        {
                            <MudText Typo="Typo.caption" Class="d-block mt-2">
                                @Localizer[MoveTargetZone == StorageZone.Freezer ? "Stock.FreezeHint" : "Stock.ThawHint"]
                            </MudText>
                        }
                    }
                </div>

                @if (!ReferenceEquals(lot, group.Last()))
                {
                    <MudDivider/>
                }
            }
        </MudPaper>
    }
}